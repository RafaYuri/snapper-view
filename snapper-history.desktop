[Desktop Entry]
Type=Service
MimeType=all/allfiles;inode/directory;
Actions=openSnapshots;
X-KDE-Priority=TopLevel

[Desktop Action openSnapshots]
Name=Browse versions in Snapshots...
Name[pt_BR]=Ver versões nos Snapshots...
Name[pt]=Ver versões nos Snapshots...
Name[es]=Ver versiones en instantáneas...
Icon=document-revert
Exec=bash -c '$HOME/.local/bin/snapper-view "$1"' _ "%f"
